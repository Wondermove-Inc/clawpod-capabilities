{
  "schemaVersion": 1,
  "kind": "openclaw.harness.v1",
  "name": "codex-claude-project-development",
  "title": "Codex & Claude Project Development",
  "description": "Use to onboard Codex or Claude, register projects, and coordinate cross-process coding sessions, leases, and git context; use ordinary coding for in-process edits and GitHub for remote repository operations.",
  "version": "0.2.3",
  "entrypoint": "./codex_claude_project_development.py",
  "packageRoot": ".",
  "execution": {
    "cwd": ".",
    "timeoutMs": 125000,
    "requiresJson": true
  },
  "whenToUse": [
    "Onboard Claude for this project",
    "Resume a cross-process coding session",
    "Coordinate Codex and Claude leases"
  ],
  "capabilities": [
    "mandatory-onboarding",
    "canonical-git-context",
    "local-registry",
    "compare-and-swap",
    "leases",
    "separate-agent-lineages",
    "acpx-named-sessions",
    "secret-rejection",
    "no-gateway-callback"
  ],
  "authModel": {
    "type": "runtime",
    "storesSecrets": false,
    "requiresHumanAccount": true
  },
  "commands": {
