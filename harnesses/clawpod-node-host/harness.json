{
  "schemaVersion": 1,
  "kind": "openclaw.harness.v1",
  "name": "clawpod-node-host",
  "title": "ClawPod Node Host",
  "description": "Use when a user wants to connect a Mac or Windows 11 PC to ClawPod as a node without manually configuring networking, SSH, or the node service. Can guide the human-only sign-in and approval steps, then automate Tailscale, SSH readiness, node installation, pairing, verification, recovery, and removal. Use node-connect instead when an already configured node fails to connect or pair.",
  "version": "0.1.2",
  "entrypoint": "./clawpod_node_host.py",
  "packageRoot": ".",
  "execution": {
    "cwd": ".",
    "timeoutMs": 60000,
    "requiresJson": true
  },
  "whenToUse": [
    "Connect this Mac to ClawPod as a node without making me configure networking or SSH",
    "Set up a Windows 11 PC as a ClawPod node and guide me through sign-in and approval",
    "Automate Tailscale, node installation, recovery, or removal for this new ClawPod node",
    "Check whether a local machine is ready to become a node"
  ],
  "capabilities": [
    "exact-version-gate",
    "pre-node-bootstrap",
    "strict-ssh-host-key-binding",
    "protected-credential-references",
    "tailscale-install-login-address",
    "same-tailnet-verification",
    "plan-bound-ssh-server-readiness",
    "plan-bound-lifecycle",
    "resumable-owner-state",
    "exact-device-pairing",
    "system-browser-validation"
  ],
  "authModel": {
    "type": "protected-environment-or-existing-config",
    "storesSecrets": false,
    "requiresHumanAccount": true
  },
  "commands": {
