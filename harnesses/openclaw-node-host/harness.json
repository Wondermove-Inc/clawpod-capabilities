  "schemaVersion": 1,
  "kind": "openclaw.harness.v1",
  "name": "openclaw-node-host",
  "title": "OpenClaw Node Host",
  "description": "Connect or manage a ClawPod node on Mac/Windows by inspecting readiness, applying approved plans, and pairing. Use node-connect for diagnostics.",
  "version": "0.1.0",
  "entrypoint": "./openclaw_node_host.py",
  "packageRoot": ".",
  "execution": {
    "cwd": ".",
    "timeoutMs": 60000,
    "requiresJson": true
  },
  "whenToUse": [
    "ClawPod 노드 연결을 도와줘",
    "Set up a Mac or Windows PC as an OpenClaw node",
    "Install, repair, resume, restart, roll back, or uninstall its node service",
    "Check whether a local machine is ready to become a node"
  ],
  "capabilities": [
    "exact-version-gate",
    "tailscale-verification-only",
    "plan-bound-lifecycle",
    "resumable-owner-state",
    "exact-device-pairing",
    "system-browser-validation"
  ],
  "authModel": {
    "type": "protected-environment-or-existing-config",
    "storesSecrets": false,
    "requiresHumanAccount": true
  },
