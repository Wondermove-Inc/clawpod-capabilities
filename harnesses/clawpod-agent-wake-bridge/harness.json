        {
          "arg": "targetUrl",
          "type": "option",
          "flag": "--target-url",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "documentFile",
          "type": "option",
          "flag": "--document-file",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        },
        {
          "arg": "replyContentFile",
          "type": "option",
          "flag": "--reply-content-file",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        }
      ]
    },
