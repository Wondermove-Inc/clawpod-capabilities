          "ok",
          "command",
          "status",
          "data",
          "error",
          "timing"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "command": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "data": {},
          "error": {},
          "timing": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "argMap": [
        {
          "arg": "request",
          "type": "option",
          "flag": "--request",
          "valueType": "path",
          "pathRole": "input",
          "optional": false
        },
        {
          "arg": "allowHosts",
          "type": "option",
          "flag": "--allow-host",
          "valueType": "string",
