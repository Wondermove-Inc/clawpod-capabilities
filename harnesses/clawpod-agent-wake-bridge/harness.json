              "inbox",
              "document",
              "request"
            ]
          },
          "workspaceRoot": {
            "type": "string"
          },
          "documentFile": {
            "type": "string"
          },
          "bind": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "output": {
            "type": "string"
          },
          "readyFile": {
            "type": "string"
          },
          "stagingDir": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "command",
          "status",
          "data",
          "error",
          "timing"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "command": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "data": {},
          "error": {},
          "timing": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "argMap": [
        {
          "arg": "request",
          "type": "option",
          "flag": "--request",
          "valueType": "path",
          "pathRole": "input",
          "optional": false
        },
        {
          "arg": "allowHosts",
          "type": "option",
          "flag": "--allow-host",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "mode",
          "type": "option",
          "flag": "--mode",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "workspaceRoot",
          "type": "option",
          "flag": "--workspace-root",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        },
        {
          "arg": "documentFile",
          "type": "option",
          "flag": "--document-file",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        },
        {
          "arg": "bind",
          "type": "option",
          "flag": "--bind",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "port",
          "type": "option",
          "flag": "--port",
          "valueType": "integer",
          "optional": true
        },
        {
          "arg": "output",
          "type": "option",
          "flag": "--output",
          "valueType": "path",
          "pathRole": "output",
          "optional": true
        },
        {
          "arg": "readyFile",
          "type": "option",
          "flag": "--ready-file",
          "valueType": "path",
          "pathRole": "output",
          "optional": true
        },
        {
          "arg": "stagingDir",
          "type": "option",
          "flag": "--staging-dir",
          "valueType": "path",
          "pathRole": "output",
          "optional": true
        }
      ]
