{
  "schemaVersion": 1,
  "kind": "openclaw.harness.v1",
  "name": "clawpod-agent-wake-bridge",
  "title": "ClawPod Agent Wake Bridge",
  "description": "Validate correlated bridge rounds, send authorized wakes, stage authenticated Markdown, and await one bounded callback.",
  "version": "0.1.1",
  "entrypoint": "./bridge.py",
  "packageRoot": ".",
  "commands": {
    "preflight": {
      "description": "preflight a bounded bridge round using strict JSON input.",
      "baseArgv": [
        "preflight"
      ],
      "safetyClasses": [
        "readOnly",
        "secretUse"
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "request",
          "allowHosts"
        ],
        "properties": {
          "request": {
            "type": "string"
          },
          "allowHosts": {
            "type": "string"
          },
          "workspaceRoot": {
            "type": "string"
          },
          "documentFile": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "command",
          "status",
          "data",
          "error",
          "timing"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "command": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "data": {},
          "error": {},
          "timing": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "argMap": [
        {
          "arg": "request",
          "type": "option",
          "flag": "--request",
          "valueType": "path",
          "pathRole": "input",
          "optional": false
        },
        {
          "arg": "allowHosts",
          "type": "option",
          "flag": "--allow-host",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "workspaceRoot",
          "type": "option",
          "flag": "--workspace-root",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        },
        {
          "arg": "documentFile",
          "type": "option",
          "flag": "--document-file",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        }
      ]
    },
    "send": {
      "description": "Send a full envelope or construct a correlated reply from original request plus text/result content.",
      "baseArgv": [
        "send"
      ],
      "safetyClasses": [
        "secretUse",
        "externalSideEffect"
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "request",
          "allowHosts",
          "targetUrl"
        ],
