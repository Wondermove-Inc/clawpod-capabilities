{
  "schemaVersion": 1,
  "kind": "openclaw.harness.v1",
  "name": "memory-graph",
  "title": "Memory Graph",
  "description": "Build, reconcile, and verify a private Memory MCP graph for connected historical context across decisions, people, projects, and causes; use Memory Search for simple facts.",
  "version": "0.8.0",
  "entrypoint": "./memory_graph.py",
  "packageRoot": ".",
  "execution": {
    "cwd": ".",
    "timeoutMs": 35000,
    "requiresJson": true
  },
  "whenToUse": [
    "Immediately after installation for per-agent core-context and memory graph onboarding",
    "An agent needs connected historical context across decisions, people, projects, causes, or changes that simple Memory Search cannot reconstruct"
  ],
  "capabilities": [
    "autonomous-memory-onboarding",
    "agent-namespace-isolation",
    "rebuildable-graph-planning",
    "safe-resumable-reconciliation",
    "memory-mcp-verification",
    "grounded-semantic-projection",
    "bounded-semantic-query",
    "provenance-bearing-assertions",
    "closed-shape-validation",
    "competency-question-evaluation",
    "semantic-first-visualization"
  ],
  "authModel": {
    "type": "none",
    "storesSecrets": false,
    "requiresHumanAccount": false
  },
