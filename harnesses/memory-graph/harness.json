{
  "schemaVersion": 1,
  "kind": "openclaw.harness.v1",
  "name": "memory-graph",
  "title": "Memory Graph",
  "description": "Build, reconcile, and verify a private Memory MCP graph for connected historical context across decisions, people, projects, and causes; use Memory Search for simple facts.",
  "version": "0.6.0",
  "entrypoint": "./memory_graph.py",
  "packageRoot": ".",
  "execution": {
    "cwd": ".",
    "timeoutMs": 35000,
    "requiresJson": true
  },
  "whenToUse": [
    "Immediately after installation for per-agent core-context and memory graph onboarding",
    "An agent needs connected historical context across decisions, people, projects, causes, or changes that simple Memory Search cannot reconstruct"
  ],
  "capabilities": [
    "autonomous-memory-onboarding",
    "agent-namespace-isolation",
    "rebuildable-graph-planning",
    "safe-resumable-reconciliation",
    "memory-mcp-verification",
    "grounded-semantic-projection",
    "bounded-semantic-query"
  ],
  "authModel": {
    "type": "none",
    "storesSecrets": false,
    "requiresHumanAccount": false
  },
  "commands": {
    "inspect": {
      "description": "Parse and validate memory and return a bounded count/digest summary suitable for Gateway preview.",
      "baseArgv": [
        "inspect"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root": {
            "type": "string"
          },
          "secretPolicy": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "schema_version",
          "command",
          "effects"
        ]
      },
      "argMap": [
        {
          "arg": "root",
          "type": "option",
          "flag": "--root",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        },
        {
          "arg": "secretPolicy",
          "type": "option",
          "flag": "--secret-policy",
          "valueType": "string",
          "optional": true
        }
      ]
    },
    "plan": {
      "description": "Build a graph plan and return a bounded count/hash summary suitable for Gateway preview.",
      "baseArgv": [
        "plan"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agentId"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "secretPolicy": {
            "type": "string"
          },
          "includeInferred": {
            "type": "boolean"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "schema_version",
          "command",
          "effects"
        ]
      },
      "argMap": [
        {
          "arg": "root",
          "type": "option",
          "flag": "--root",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        },
        {
          "arg": "agentId",
          "type": "option",
          "flag": "--agent-id",
          "valueType": "string"
        },
        {
          "arg": "workspaceId",
          "type": "option",
          "flag": "--workspace-id",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "secretPolicy",
          "type": "option",
          "flag": "--secret-policy",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "includeInferred",
          "type": "booleanFlag",
          "flag": "--include-inferred",
          "valueType": "boolean",
          "optional": true
        }
      ]
    },
    "validate-plan": {
      "description": "Validate a saved plan/snapshot and its deterministic hash.",
      "baseArgv": [
        "validate-plan"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan"
        ],
        "properties": {
          "plan": {
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "schema_version",
          "command",
          "effects"
        ]
      },
      "argMap": [
        {
          "arg": "plan",
          "type": "option",
          "flag": "--plan",
          "valueType": "path",
          "pathRole": "input"
        },
        {
          "arg": "root",
          "type": "option",
          "flag": "--root",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        }
      ]
    },
    "validate-snapshot": {
      "description": "Validate snapshot structure, invariants, and content hash.",
      "baseArgv": [
        "validate-snapshot"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot"
        ],
        "properties": {
          "snapshot": {
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "schema_version",
          "command",
          "effects"
        ]
      },
      "argMap": [
        {
          "arg": "snapshot",
          "type": "option",
          "flag": "--snapshot",
          "valueType": "path",
          "pathRole": "input"
        },
        {
          "arg": "root",
          "type": "option",
          "flag": "--root",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        }
      ]
    },
    "onboard": {
      "description": "Autonomously reconcile and verify only this agent's namespaced derived graph through a schema-verified direct Memory MCP backend.",
      "baseArgv": [
        "onboard"
      ],
      "safetyClasses": [
        "writeSafe"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agentId",
          "stateRoot"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "stateRoot": {
            "type": "string"
          },
          "timeoutSeconds": {
            "type": "integer"
          },
          "secretPolicy": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "schema_version",
          "command",
          "effects"
        ]
      },
      "argMap": [
        {
          "arg": "root",
          "type": "option",
          "flag": "--root",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        },
        {
          "arg": "agentId",
          "type": "option",
          "flag": "--agent-id",
          "valueType": "string"
        },
        {
          "arg": "workspaceId",
          "type": "option",
          "flag": "--workspace-id",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "stateRoot",
          "type": "option",
          "flag": "--state-root",
          "valueType": "path",
          "pathRole": "output"
        },
        {
          "arg": "timeoutSeconds",
          "type": "option",
          "flag": "--timeout-seconds",
          "valueType": "integer",
          "optional": true
        },
        {
          "arg": "secretPolicy",
          "type": "option",
          "flag": "--secret-policy",
          "valueType": "string",
          "optional": true
        }
      ]
    },
    "cron-plan": {
      "description": "Return an idempotent deterministic job name and a current Gateway cron.add agentTurn payload.",
      "baseArgv": [
        "cron-plan"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agentId",
          "stateRoot",
          "timezone"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "stateRoot": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "schema_version",
          "command",
          "effects"
        ]
      },
      "argMap": [
        {
          "arg": "root",
          "type": "option",
          "flag": "--root",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        },
        {
          "arg": "agentId",
          "type": "option",
          "flag": "--agent-id",
          "valueType": "string"
        },
        {
          "arg": "workspaceId",
          "type": "option",
          "flag": "--workspace-id",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "stateRoot",
          "type": "option",
          "flag": "--state-root",
          "valueType": "path",
          "pathRole": "output"
        },
        {
          "arg": "timezone",
          "type": "option",
          "flag": "--timezone",
          "valueType": "string"
        }
      ]
    },
    "query-plan": {
      "description": "Build a bounded deterministic semantic locator query plan from a saved snapshot.",
      "baseArgv": [
        "query-plan"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "statuses": {
            "type": "string"
          },
          "maxDepth": {
            "type": "integer"
          },
          "maxEntities": {
            "type": "integer"
          },
          "maxEdges": {
            "type": "integer"
          },
          "explain": {
            "type": "boolean"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "schema_version",
          "command",
          "effects"
        ]
      },
      "argMap": [
        {
          "arg": "input",
          "type": "option",
          "flag": "--input",
          "valueType": "path",
          "pathRole": "input"
        },
        {
          "arg": "root",
          "type": "option",
          "flag": "--root",
          "valueType": "path",
          "pathRole": "input",
          "optional": true
        },
        {
          "arg": "entityId",
          "type": "option",
          "flag": "--entity-id",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "entityType",
          "type": "option",
          "flag": "--entity-type",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "relation",
          "type": "option",
          "flag": "--relation",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "direction",
          "type": "option",
          "flag": "--direction",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "statuses",
          "type": "option",
          "flag": "--statuses",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "maxDepth",
          "type": "option",
          "flag": "--max-depth",
          "valueType": "integer",
          "optional": true
        },
        {
          "arg": "maxEntities",
          "type": "option",
          "flag": "--max-entities",
          "valueType": "integer",
          "optional": true
        },
        {
          "arg": "maxEdges",
          "type": "option",
          "flag": "--max-edges",
          "valueType": "integer",
          "optional": true
        },
        {
          "arg": "explain",
          "type": "booleanFlag",
          "flag": "--explain",
          "valueType": "boolean",
          "optional": true
        }
      ]
    }
  }
}
