{
  "schemaVersion": 1,
  "kind": "openclaw.harness.v1",
  "name": "workboard-delegation",
  "title": "Workboard Delegation",
  "description": "Pure deterministic planning and snapshot validation for scoped Workboard delegation.",
  "version": "0.3.1",
  "entrypoint": "./workboard_delegation.py",
  "packageRoot": ".",
  "execution": {
    "cwd": ".",
    "timeoutMs": 5000,
    "requiresJson": true
  },
  "whenToUse": [
    "Plan and verify delegation packets before and after first-class Workboard tool calls"
  ],
  "capabilities": [
    "deterministic-plan",
    "snapshot-validation",
    "reconciliation-planning",
    "no-backend-calls"
  ],
  "authModel": {
    "type": "none",
    "storesSecrets": false,
    "requiresHumanAccount": false
  },
  "commands": {
    "status": {
      "description": "Report the pure local contract.",
      "baseArgv": [
        "status"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "required": [],
        "properties": {},
        "additionalProperties": false
      },
      "argMap": []
    },
    "plan": {
      "description": "Build an exact delegation packet, idempotency key, notes, comment marker, and stable plan hash.",
      "baseArgv": [
        "plan"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "leaderId",
          "title",
          "agentId",
          "scope",
          "doneWhen",
          "evidenceRequired",
          "reportBackTarget"
        ],
        "properties": {
          "leaderId": {
            "type": "string"
          },
          "expectedLeaderOwnerId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "nonGoals": {
            "type": "string"
          },
          "doneWhen": {
            "type": "string"
          },
          "evidenceRequired": {
            "type": "string"
          },
          "reportBackTarget": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "boardId": {
            "type": "string"
          },
          "labels": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "argMap": [
        {
          "arg": "leaderId",
          "type": "option",
          "flag": "--leader-id",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "expectedLeaderOwnerId",
          "type": "option",
          "flag": "--expected-leader-owner-id",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "title",
          "type": "option",
          "flag": "--title",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "agentId",
          "type": "option",
          "flag": "--agent-id",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "scope",
          "type": "option",
          "flag": "--scope",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "nonGoals",
          "type": "option",
          "flag": "--non-goals",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "doneWhen",
          "type": "option",
          "flag": "--done-when",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "evidenceRequired",
          "type": "option",
          "flag": "--evidence-required",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "reportBackTarget",
          "type": "option",
          "flag": "--report-back-target",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "tenant",
          "type": "option",
          "flag": "--tenant",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "boardId",
          "type": "option",
          "flag": "--board-id",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "labels",
          "type": "option",
          "flag": "--labels",
          "valueType": "string",
          "optional": true
        }
      ]
    },
    "validate-leader": {
      "description": "Validate a bounded leader snapshot against the approved plan and expected owner.",
      "baseArgv": [
        "validate-leader"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "planJson",
          "planHash",
          "leaderSnapshot"
        ],
        "properties": {
          "planJson": {
            "type": "string"
          },
          "planHash": {
            "type": "string"
          },
          "leaderSnapshot": {
            "type": "string"
          },
          "expectedLeaderOwnerId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "argMap": [
        {
          "arg": "planJson",
          "type": "option",
          "flag": "--plan-json",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "planHash",
          "type": "option",
          "flag": "--plan-hash",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "leaderSnapshot",
          "type": "option",
          "flag": "--leader-snapshot",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "expectedLeaderOwnerId",
          "type": "option",
          "flag": "--expected-leader-owner-id",
          "valueType": "string",
          "optional": true
        }
      ]
    },
    "validate-result": {
      "description": "Verify approved plan fields, execution automation metadata, no parents, and one leader comment.",
      "baseArgv": [
        "validate-result"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "planJson",
          "planHash",
          "leaderSnapshot",
          "executionSnapshot"
        ],
        "properties": {
          "planJson": {
            "type": "string"
          },
          "planHash": {
            "type": "string"
          },
          "leaderSnapshot": {
            "type": "string"
          },
          "expectedLeaderOwnerId": {
            "type": "string"
          },
          "executionSnapshot": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "argMap": [
        {
          "arg": "planJson",
          "type": "option",
          "flag": "--plan-json",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "planHash",
          "type": "option",
          "flag": "--plan-hash",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "leaderSnapshot",
          "type": "option",
          "flag": "--leader-snapshot",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "expectedLeaderOwnerId",
          "type": "option",
          "flag": "--expected-leader-owner-id",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "executionSnapshot",
          "type": "option",
          "flag": "--execution-snapshot",
          "valueType": "string",
          "optional": false
        }
      ]
    },
    "reconcile-plan": {
      "description": "Emit exact missing first-class Workboard actions without mutating.",
      "baseArgv": [
        "reconcile-plan"
      ],
      "safetyClasses": [
        "readOnly"
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "planJson",
          "planHash",
          "leaderSnapshot"
        ],
        "properties": {
          "planJson": {
            "type": "string"
          },
          "planHash": {
            "type": "string"
          },
          "leaderSnapshot": {
            "type": "string"
          },
          "expectedLeaderOwnerId": {
            "type": "string"
          },
          "executionSnapshot": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "argMap": [
        {
          "arg": "planJson",
          "type": "option",
          "flag": "--plan-json",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "planHash",
          "type": "option",
          "flag": "--plan-hash",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "leaderSnapshot",
          "type": "option",
          "flag": "--leader-snapshot",
          "valueType": "string",
          "optional": false
        },
        {
          "arg": "expectedLeaderOwnerId",
          "type": "option",
          "flag": "--expected-leader-owner-id",
          "valueType": "string",
          "optional": true
        },
        {
          "arg": "executionSnapshot",
          "type": "option",
          "flag": "--execution-snapshot",
          "valueType": "string",
          "optional": true
        }
      ]
    }
  }
}
