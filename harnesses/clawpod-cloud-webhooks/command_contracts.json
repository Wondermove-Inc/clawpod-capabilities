{
  "schemaVersion": 1,
  "canonicalName": "clawpod-cloud-webhooks",
  "title": "ClawPod Cloud Webhooks",
  "output": {
    "type": "object",
    "required": [
      "ok"
    ],
    "redaction": "recursive denylist plus bearer and URL-token path redaction"
  },
  "global": {
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "timeout": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 30
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "caCertPath": {
      "type": "path",
      "role": "input",
      "required": false,
      "validation": "readable regular PEM file; never persisted or copied"
    },
    "insecureSkipTlsVerify": {
      "type": "boolean",
      "required": false
    },
    "insecureTlsRiskAccepted": {
      "type": "boolean",
      "const": true,
      "requiredWith": "insecureSkipTlsVerify"
    }
  },
  "readCommands": [
    "system.version",
    "auth.contract",
    "auth.onboard",
    "auth.status",
    "permissions.list",
    "presets.list",
    "source.list",
    "source.get",
    "playbook.list",
    "playbook.get",
    "rule.list",
    "rule.get",
    "event.list",
    "event.get",
    "event.inspect-redacted",
    "event.verify",
    "audit.config"
  ],
  "mutationCommands": {
    "mutation.preview": {
      "sideEffect": false,
      "actions": [
        "create",
        "update",
        "delete",
        "action"
      ],
      "required": [
        "kind",
        "tenantId",
        "idempotencyKey"
      ]
    },
    "source.create": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative GET readback"
    },
    "source.update": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative GET readback"
    },
    "source.delete": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative list absence"
    },
    "source.enable": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative GET readback"
    },
    "source.disable": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative GET readback"
    },
    "playbook.create": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative GET readback"
    },
    "playbook.update": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative GET readback"
    },
    "playbook.delete": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative list absence"
    },
    "rule.create": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative GET readback"
    },
    "rule.update": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative GET readback"
    },
    "rule.delete": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative list absence"
    },
    "rule.enable": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative GET readback"
    },
    "rule.disable": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "authoritative GET readback"
    },
    "rule.reorder": {
      "sideEffect": true,
      "approvalRequired": true,
      "retry": "never blind retry",
      "verification": "GET Rule priority readback"
    },
    "source.rotate-secret": {
      "sideEffect": true,
      "approvalRequired": true,
      "secretUse": true,
      "retry": "never blind retry",
      "verification": "GET Source overlap metadata; returned secret redacted"
    },
    "source.regenerate": {
      "sideEffect": true,
      "approvalRequired": true,
      "secretUse": true,
      "retry": "never blind retry",
      "verification": "GET Source overlap metadata; returned secret redacted"
    },
    "source.test-local": {
      "sideEffect": false,
      "secretUse": true,
      "required": [
        "bodyFile",
        "idempotencyKey"
      ]
    }
  },
  "guards": {
    "payloadMaxBytes": 1048576,
    "brokenOperators": [
      "in",
      "not_in",
      "gt",
      "lt",
      "gte",
      "lte"
    ],
    "messageTemplate": "rejected",
    "agentTarget": "blocked without destination evidence proof",
    "eventSuccess": "status delivered AND empty error_message AND destination evidence when required"
  },
  "onboarding": {
    "command": "auth.onboard",
    "sideEffect": false,
    "secretUse": true,
    "humanAccountAction": true,
    "approvalRequired": true,
    "required": [
      "baseUrl",
      "approveLogin"
    ],
    "optional": [
      "tenantId",
      "caCertPath",
      "insecureSkipTlsVerify",
      "insecureTlsRiskAccepted"
    ],
    "sessionPersistence": false,
    "gatewaySecretInjection": false,
    "protectedExecutionLane": "exec.useSecrets",
    "stopsBeforeMutation": true
  },
  "tls": {
    "default": "strict",
    "modes": [
      "strict",
      "custom_ca",
      "insecure_approved"
    ],
    "customCaPreferred": true,
    "httpRejected": true,
    "mutuallyExclusive": [
      "caCertPath",
      "insecureSkipTlsVerify"
    ],
    "insecureApprovalFlag": "--i-understand-insecure-tls-risk",
    "scope": "process/client instance only",
    "environmentBypass": false
  },
  "directCredentialSecretBinding": {
    "kind": "gateway-memory-secret-per-run",
    "parameter": "secretRefs",
    "names": [
      "CLAWPOD_CLOUD_EMAIL",
      "CLAWPOD_CLOUD_PASSWORD"
    ],
    "prepareRunMustMatch": true,
    "manifestStoresPointer": false
  },
  "eventMutationRoutesEvidenced": [],
  "eventActions": [
    "list",
    "get",
    "inspect-redacted",
    "verify"
  ]
}
