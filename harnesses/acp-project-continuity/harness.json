{
  "schemaVersion": 1,
  "kind": "openclaw.harness.v1",
  "name": "acp-project-continuity",
  "title": "ACP Project Continuity",
  "description": "Pure-local fail-closed registry for separate project-level Codex and Claude ACP session lineages.",
  "version": "0.1.0",
  "entrypoint": "./acp_project_continuity.py",
  "packageRoot": ".",
  "execution": {
    "cwd": ".",
    "timeoutMs": 5000,
    "requiresJson": true
  },
  "whenToUse": [
    "After installation, onboard Codex, Claude, or both before registering or resuming project sessions",
    "Validate project context, coordinate concurrent local agents, rotate or close ACP session lineages"
  ],
  "capabilities": [
    "mandatory-onboarding",
    "local-registry",
    "compare-and-swap",
    "leases",
    "separate-agent-lineages",
    "secret-rejection",
    "no-backend-calls"
  ],
  "authModel": {
    "type": "none",
    "storesSecrets": false,
    "requiresHumanAccount": false
  },
