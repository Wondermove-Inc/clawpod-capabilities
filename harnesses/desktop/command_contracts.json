    "ui.observe": {
      "safetyClass": "S0",
      "timeoutMs": 30000,
      "idempotencyRequired": false,
      "dryRun": false,
      "evidence": true,
      "innerInputSchema": {
        "type": "object",
        "properties": {
          "prepareFocusGuard": {
            "const": true
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "prepareFocusGuard"
              ]
            },
            "then": {
              "required": [
                "target"
              ],
              "properties": {
                "target": {
                  "type": "object",
                  "required": [
                    "windowId",
                    "kind",
                    "visualRegion"
                  ],
                  "properties": {
                    "windowId": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:[0-9]+|0[xX][0-9a-fA-F]+)$"
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        }
                      ]
                    },
                    "kind": {
                      "enum": [
                        "coordinate",
                        "image"
                      ]
                    }
                  }
                },
                "args": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          }
        ]
      },
      "focusGuardPreparation": "Requires exact existing DISPLAY=:99; aliases/missing/other displays fail before backend I/O, without changing the environment. prepareFocusGuard:true requires a known exact windowId and supported visual target. Returns target and focusGuard from the same new observation and bounded identity readback. No focus repair. Copy both unchanged into Return; reobserve after typing or focus changes."
    },
