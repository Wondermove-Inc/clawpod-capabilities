{
  "schemaVersion": 1,
  "providers": {
    "openai": {"secretEnvironment": "OPENAI_API_KEY", "auth": "owner-scoped protected secret"},
    "vertex": {"secretEnvironment": null, "auth": "ADC/OAuth/service-account lifecycle", "requires": ["project", "location", "iam"]},
    "bfl": {"secretEnvironment": "BFL_API_KEY", "auth": "owner-scoped protected secret"},
