{
  "schemaVersion": 1,
  "kind": "openclaw.harness.v1",
  "name": "open-design",
  "title": "Open Design",
  "description": "Use when the user asks for a designed deliverable to build, share, and iterate on — a deck, UI prototype, one-pager, or dashboard — living on the team's OpenDesign server as a clickable live-preview link: author the HTML, upload it, hand over the link, revise on feedback, and export HTML/ZIP or import Claude Design zips. Onboards with the server's Base URL and token. Use claude-design for claude.ai canvas editing, artifact-design for in-room artifacts, and Image Studio for stills.",
  "version": "0.1.0",
  "entrypoint": "./open_design.py",
  "packageRoot": ".",
  "execution": {
    "cwd": ".",
    "timeoutMs": 150000,
    "requiresJson": true
  },
  "whenToUse": [
    "Make a presentation deck and share it as a live preview link",
    "Build a UI prototype the team can open and click through",
    "Revise the design on the OpenDesign server and refresh its preview link",
    "Onboard the OpenDesign server with its base URL and token",
    "Export the OpenDesign project as HTML or a ZIP archive"
  ],
  "capabilities": [
    "self-hosted-open-design",
    "protected-token-env",
    "tls-trust-configuration",
    "auth-enforcement-probe",
    "byte-identical-upload-verify",
    "scoped-preview-links",
    "claude-design-import"
  ],
  "authModel": {
    "type": "protected-environment-or-existing-config",
    "storesSecrets": false,
    "requiresHumanAccount": false
  },
