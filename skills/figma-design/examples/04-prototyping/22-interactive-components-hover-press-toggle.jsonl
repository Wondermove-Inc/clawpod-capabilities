{"command": "node.create", "as": "grid", "params": {"type": "frame", "name": "Button variants", "parent": {"$ref": "sheet"}, "props": {"layout": "grid", "gridColumns": 3, "columnGap": 24, "rowGap": 24, "columnTracks": ["auto", "auto", "auto"], "fill": "none", "sizingH": "hug", "sizingV": "hug"}}}
