{"command": "node.create", "as": "header", "params": {"type": "frame", "name": "Header", "parent": {"$ref": "sheet"}, "props": {"layout": "vertical", "gap": 6, "sizingH": "fill", "fill": "none", "clip": false, "sizingV": "hug"}}}
{"command": "node.create", "params": {"type": "text", "name": "Interactive components", "parent": {"$ref": "header"}, "text": "Interactive components", "props": {"textStyle": "Heading/2", "fill": {"$var": "text/primary"}, "sizingH": "fill", "wrapStyle": "pretty"}}}
