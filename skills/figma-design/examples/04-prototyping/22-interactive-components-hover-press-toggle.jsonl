{"command": "node.create", "as": "tg__2", "params": {"type": "frame", "name": "On=True", "parent": {"$ref": "grid__2"}, "width": 52, "height": 32, "props": {"layout": "horizontal", "padding": 3, "mainAlign": "max", "crossAlign": "center", "cornerRadius": 16, "fill": {"$var": "brand/primary"}}}}
