{"command": "node.create", "params": {"type": "text", "parent": {"$ref": "section_gear"}, "text": "Nothing technical. The ridge is colder than the car park by five degrees, and the spring is the only water on the route, so carry what you need for the first half.", "props": {"textStyle": "Body/L", "fill": {"$var": "text/secondary"}, "sizingH": "fill", "wrapStyle": "pretty"}}}
