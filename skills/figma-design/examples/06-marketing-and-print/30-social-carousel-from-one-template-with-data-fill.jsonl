{"command": "node.create", "params": {"type": "text", "name": "Body", "parent": {"$ref": "content"}, "text": "Supporting line", "props": {"fill": "#C7D8F2", "fontSize": 38, "lineHeight": "140%", "sizingH": "fill", "textAutoResize": "height", "wrapStyle": "balance"}}}
{"command": "node.create", "as": "footer", "params": {"type": "frame", "name": "Footer", "parent": {"$ref": "post_template"}, "props": {"layout": "horizontal", "gap": 0, "sizingH": "fill", "mainAlign": "spaceBetween", "crossAlign": "center", "fill": "none", "clip": false, "sizingV": "hug"}}}
