{"command": "data.fill", "as": "made", "params": {"id": {"$ref": "post_template"}, "gap": 120, "formats": [{"name": "portrait", "width": 1080, "height": 1350}, {"name": "story", "width": 1080, "height": 1920}, {"name": "square", "width": 1080, "height": 1080}], "rows": [{"name": "01-cover", "Number": {"visible": false}, "Kicker": "DESIGN HANDOFF", "Headline": {"text": "Four habits that make developers trust your files", "fit": {"maxLines": 4}}, "Body": "Swipe for the checklist we use on every project.", "Page": "1 / 5"}, {"name": "02-names", "Number": "01", "Kicker": "HABIT 01", "Headline": {"text": "Name layers the way the code will", "fit": {"maxLines": 3}}, "Body": "Button / Primary, not Frame 482.", "Page": "2 / 5", "Badge": {"visible": false}}, {"name": "03-tokens", "Number": "02", "Kicker": "HABIT 02", "Headline": {"text": "Tokens first, screens second", "fit": {"maxLines": 3}}, "Body": "Every colour and space is a variable before it is a pixel.", "Page": "3 / 5", "Badge": {"visible": false}}, {"name": "04-states", "Number": "03", "Kicker": "HABIT 03", "Headline": {"text": "Design the empty, loading and error states", "fit": {"maxLines": 4}}, "Body": "The happy path is a quarter of the work.", "Page": "4 / 5", "Badge": {"visible": false}}, {"name": "05-status", "Number": "04", "Kicker": "HABIT 04", "Headline": {"text": "Mark what is ready and what changed", "fit": {"maxLines": 3}}, "Body": "Ready for dev on the frame, and a note on what moved since last time.", "Page": "5 / 5", "Badge": {"visible": false}}]}}
