{"command": "style.create", "params": {"type": "effect", "name": "Elevation/1", "value": [{"type": "dropShadow", "color": "#0F172A0F", "offset": [0, 1], "radius": 2}, {"type": "dropShadow", "color": "#0F172A14", "offset": [0, 2], "radius": 8}]}}
{"command": "style.create", "params": {"type": "effect", "name": "Elevation/2", "value": [{"type": "dropShadow", "color": "#0F172A14", "offset": [0, 2], "radius": 4}, {"type": "dropShadow", "color": "#0F172A1F", "offset": [0, 12], "radius": 24}]}}
{"command": "style.create", "params": {"type": "effect", "name": "Elevation/3", "value": [{"type": "dropShadow", "color": "#0F172A1A", "offset": [0, 8], "radius": 16}, {"type": "dropShadow", "color": "#0F172A29", "offset": [0, 24], "radius": 48}]}}
{"command": "node.create", "as": "sheet", "params": {"type": "frame", "name": "Images", "x": 0, "y": 0, "width": 1160, "props": {"layout": "vertical", "gap": 32, "padding": 48, "sizingV": "hug", "cornerRadius": 24, "fill": {"$var": "bg/surface"}, "stroke": {"$var": "border/subtle"}, "strokeWeight": 1}}}
{"command": "node.create", "as": "header", "params": {"type": "frame", "name": "Header", "parent": {"$ref": "sheet"}, "props": {"layout": "vertical", "gap": 6, "sizingH": "fill", "fill": "none", "clip": false, "sizingV": "hug"}}}
{"command": "node.create", "params": {"type": "text", "name": "Images", "parent": {"$ref": "header"}, "text": "Images", "props": {"textStyle": "Heading/2", "fill": {"$var": "text/primary"}, "sizingH": "fill"}}}
{"command": "node.create", "params": {"type": "text", "parent": {"$ref": "header"}, "text": "An image is a paint, not a layer type: it fills a shape, so cropping is just the shape's geometry.", "props": {"textStyle": "Body/M", "fill": {"$var": "text/secondary"}, "sizingH": "fill", "wrapStyle": "pretty"}}}
{"command": "node.create", "as": "modes", "params": {"type": "frame", "name": "Modes", "parent": {"$ref": "sheet"}, "props": {"layout": "horizontal", "gap": 24, "sizingH": "fill", "fill": "none", "clip": false, "sizingV": "hug"}}}
{"command": "node.create", "as": "fill", "params": {"type": "frame", "name": "fill", "parent": {"$ref": "modes"}, "props": {"layout": "vertical", "gap": 10, "sizingH": "fill", "fill": "none", "clip": false, "sizingV": "hug"}}}
{"command": "node.create", "as": "photo_fill", "params": {"type": "rectangle", "name": "Photo / fill", "parent": {"$ref": "fill"}, "height": 200, "props": {"sizingH": "fill", "cornerRadius": 16, "fill": {"$var": "bg/subtle"}}}}
{"command": "image.place", "params": {"path": "assets/sample-scene.jpg", "target": {"$ref": "photo_fill"}, "mode": "fill"}}
{"command": "node.create", "params": {"type": "text", "name": "mode: fill", "parent": {"$ref": "fill"}, "text": "mode: fill", "props": {"textStyle": "Label/M", "fill": {"$var": "text/secondary"}}}}
