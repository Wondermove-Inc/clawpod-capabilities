// Expressive type: gradient fill, outline, text on a path, OpenType features, fitted headlines
// Shows: gradient paint on text, stroke-only display type, text following a circle, tabular figures, a variable-font weight axis (Montserrat has one; check with text.fonts {family, axes: true}), text.fit to hold a headline to two lines
{"command": "node.create", "as": "type_poster", "params": {"type": "frame", "name": "Type poster", "x": 0, "y": 0, "width": 1080, "height": 1350, "props": {"layout": "vertical", "padding": 80, "gap": 36, "fill": "#0A0A0A"}}}
{"command": "node.create", "params": {"type": "text", "name": "ISSUE 14 · AUTUMN", "parent": {"$ref": "type_poster"}, "text": "ISSUE 14 · AUTUMN", "props": {"fill": "#A3A3A3", "fontSize": 18, "fontStyle": "Semi Bold", "letterSpacing": "14%"}}}
{"command": "node.create", "as": "slow_is_a_feature", "params": {"type": "text", "name": "Slow is a feature.", "parent": {"$ref": "type_poster"}, "text": "Slow is a feature.", "props": {"fill": "#FFFFFF", "fontSize": 160, "fontStyle": "Bold", "letterSpacing": "-4%", "lineHeight": "96%", "sizingH": "fill", "textAutoResize": "height"}}}
{"command": "node.set", "params": {"ids": [{"$ref": "slow_is_a_feature"}], "props": {"fills": [{"type": "linearGradient", "stops": ["#FDE68A", "#FB7185", "#818CF8"]}]}}}
{"command": "text.fit", "params": {"ids": [{"$ref": "slow_is_a_feature"}], "maxLines": 2}}
{"command": "node.create", "as": "outline", "params": {"type": "text", "name": "OUTLINE", "parent": {"$ref": "type_poster"}, "text": "OUTLINE", "props": {"fill": "none", "fontSize": 150, "fontStyle": "Bold", "letterSpacing": "-2%", "lineHeight": "100%"}}}
{"command": "node.set", "params": {"ids": [{"$ref": "outline"}], "props": {"strokes": [{"type": "solid", "color": "#FFFFFF"}], "strokeWeight": 2}}}
{"command": "node.create", "as": "details", "params": {"type": "frame", "name": "Details", "parent": {"$ref": "type_poster"}, "props": {"layout": "horizontal", "gap": 48, "sizingH": "fill", "crossAlign": "min", "fill": "none", "clip": false, "sizingV": "hug"}}}
{"command": "node.create", "as": "figures", "params": {"type": "frame", "name": "Figures", "parent": {"$ref": "details"}, "props": {"layout": "vertical", "gap": 6, "sizingH": "fill", "fill": "none", "clip": false, "sizingV": "hug"}}}
{"command": "node.create", "params": {"type": "text", "name": "TABULAR FIGURES", "parent": {"$ref": "figures"}, "text": "TABULAR FIGURES", "props": {"fill": "#A3A3A3", "fontSize": 13, "fontStyle": "Semi Bold", "letterSpacing": "10%"}}}
{"command": "node.create", "params": {"type": "text", "name": "1,204.50", "parent": {"$ref": "figures"}, "text": "1,204.50", "props": {"fill": "#FFFFFF", "fontSize": 40, "features": {"tnum": true}, "textAlign": "right", "sizingH": "fill"}}}
{"command": "node.create", "params": {"type": "text", "name": "918.07", "parent": {"$ref": "figures"}, "text": "918.07", "props": {"fill": "#FFFFFF", "fontSize": 40, "features": {"tnum": true}, "textAlign": "right", "sizingH": "fill"}}}
{"command": "node.create", "params": {"type": "text", "name": "11,111.11", "parent": {"$ref": "figures"}, "text": "11,111.11", "props": {"fill": "#FFFFFF", "fontSize": 40, "features": {"tnum": true}, "textAlign": "right", "sizingH": "fill"}}}
{"command": "node.create", "as": "weights", "params": {"type": "frame", "name": "Weights", "parent": {"$ref": "details"}, "props": {"layout": "vertical", "gap": 6, "sizingH": "fill", "fill": "none", "clip": false, "sizingV": "hug"}}}
{"command": "node.create", "params": {"type": "text", "name": "VARIABLE WEIGHT", "parent": {"$ref": "weights"}, "text": "VARIABLE WEIGHT", "props": {"fill": "#A3A3A3", "fontSize": 13, "fontStyle": "Semi Bold", "letterSpacing": "10%"}}}
{"command": "node.create", "params": {"type": "text", "name": "Weight 200", "parent": {"$ref": "weights"}, "text": "Weight 200", "props": {"fill": "#FFFFFF", "fontSize": 40, "fontFamily": "Montserrat", "fontVariations": {"wght": 200}}}}
{"command": "node.create", "params": {"type": "text", "name": "Weight 400", "parent": {"$ref": "weights"}, "text": "Weight 400", "props": {"fill": "#FFFFFF", "fontSize": 40, "fontFamily": "Montserrat", "fontVariations": {"wght": 400}}}}
{"command": "node.create", "params": {"type": "text", "name": "Weight 550", "parent": {"$ref": "weights"}, "text": "Weight 550", "props": {"fill": "#FFFFFF", "fontSize": 40, "fontFamily": "Montserrat", "fontVariations": {"wght": 550}}}}
{"command": "node.create", "params": {"type": "text", "name": "Weight 800", "parent": {"$ref": "weights"}, "text": "Weight 800", "props": {"fill": "#FFFFFF", "fontSize": 40, "fontFamily": "Montserrat", "fontVariations": {"wght": 800}}}}
{"command": "node.create", "params": {"type": "frame", "name": "Spacer", "parent": {"$ref": "type_poster"}, "props": {"sizingH": "fill", "sizingV": "fill", "fill": "none"}}}
// Text on a path: make the text and the path, then bind them. The path layer is consumed.
{"command": "node.create", "as": "seal", "params": {"type": "frame", "name": "Seal", "parent": {"$ref": "type_poster"}, "width": 260, "height": 260, "props": {"fill": "none"}}}
{"command": "text.create", "as": "ring_text", "params": {"text": "FIELD NOTES · VOLUME FOUR · AUTUMN · ", "x": 0, "y": 0, "parent": {"$ref": "seal"}, "props": {"fontSize": 18, "fontStyle": "Semi Bold", "letterSpacing": "12%", "fill": "#FFFFFF"}}}
{"command": "node.create", "as": "circle_path", "params": {"type": "ellipse", "name": "Circle path", "parent": {"$ref": "seal"}, "x": 30, "y": 30, "width": 200, "height": 200, "props": {"fill": "none", "stroke": "#FFFFFF", "strokeWeight": 1}}}
{"command": "text.onPath", "params": {"text": {"$ref": "ring_text"}, "path": {"$ref": "circle_path"}}}
{"command": "node.create", "params": {"type": "ellipse", "name": "Dot", "parent": {"$ref": "seal"}, "x": 110, "y": 110, "width": 40, "height": 40, "props": {"fills": [{"type": "linearGradient", "stops": ["#FB7185", "#818CF8"]}]}}}
