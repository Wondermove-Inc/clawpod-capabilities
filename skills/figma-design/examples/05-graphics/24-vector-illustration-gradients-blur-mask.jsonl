// Mask: the bottom layer of the selection becomes the mask, so move the circle below the artwork first. Here it crops a copy of the scene into a badge.
{"command": "edit.duplicate", "as": "copy", "params": {"ids": [{"$ref": "poster"}], "dx": 880, "dy": 0}}
{"command": "node.create", "as": "badge", "params": {"type": "frame", "name": "Badge", "x": 880, "y": 0, "width": 800, "height": 1000, "props": {"fill": "#F8FAFC"}}}
{"command": "node.reparent", "params": {"ids": {"$ref": "copy", "field": "ids"}, "parent": {"$ref": "badge"}}}
{"command": "node.set", "params": {"ids": [{"$ref": "copy", "field": "ids/0"}], "props": {"x": 0, "y": 0}}}
{"command": "node.create", "as": "mask", "params": {"type": "ellipse", "name": "Mask", "parent": {"$ref": "badge"}, "x": 100, "y": 200, "width": 600, "height": 600, "props": {"fill": "#000000"}}}
{"command": "node.reorder", "params": {"id": {"$ref": "mask"}, "index": 0}}
{"command": "object.mask", "params": {"ids": [{"$ref": "mask"}, {"$ref": "copy", "field": "ids/0"}]}}
