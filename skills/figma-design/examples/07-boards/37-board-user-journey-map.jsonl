// Board: a user journey map
// Shows: stages as sections in a row, lanes of stickies (doing, thinking, pain points, opportunities) coloured by lane and parented to their stage, an emotion lane with a labelled scale and a point per stage
// A board is its own kind of file: stickies, shapes, connectors, sections.
{"command": "file.newBoard", "params": {"name": "Journey · first purchase"}}
{"command": "node.create", "as": "discover", "params": {"type": "section", "name": "Discover", "x": 0, "y": 0, "width": 280, "height": 1400}}
{"command": "node.create", "params": {"type": "text", "name": "Stage / Discover", "x": 20, "y": 16, "text": "Discover", "props": {"fontSize": 20, "fontStyle": "Bold"}}}
{"command": "node.create", "as": "compare", "params": {"type": "section", "name": "Compare", "x": 300, "y": 0, "width": 280, "height": 1400}}
