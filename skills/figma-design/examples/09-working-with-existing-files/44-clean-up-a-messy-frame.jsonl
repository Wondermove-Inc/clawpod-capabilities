// Before: six cards nudged by hand. After: rounded to pixels, tidied to an even grid, wrapped in auto layout, named.
{"command": "edit.duplicate", "as": "after", "params": {"ids": [{"$ref": "messy_import"}], "dx": 780, "dy": 0, "map": true}}
