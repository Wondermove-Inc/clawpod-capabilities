// Slots and exposed nested instances
// Shows: a card whose content area is a slot that instances fill with anything, a settings row that exposes its nested toggle, inserting components into a slot, reading the resulting properties
// Foundations: semantic colour variables with Light and Dark modes, then text and effect styles. Interface layers bind to these, never to raw hex; literal colours are for artwork and for data series beyond the brand.
{"command": "variable.createCollection", "params": {"name": "Theme", "modes": ["Light", "Dark"]}}
{"command": "variable.create", "params": {"collection": "Theme", "name": "bg/canvas", "type": "color", "values": {"Light": "#F8FAFC", "Dark": "#020617"}}}
